{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Partio",
  "version": "0.1.0",
  "identifier": "io.github.imbriustechnology.partio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Partio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Partio Inventory contributors. MIT licence.",
    "shortDescription": "Inventory for electronic parts, locations and BOMs",
    "longDescription": "Partio Inventory keeps track of electronic parts, where they are stored, how many you have, the assemblies they go into and what to order next. Local-only: your library stays on your computer.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
